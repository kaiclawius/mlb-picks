# --- Pflicht im Produktivbetrieb ---
NODE_ENV=production
PUBLIC_URL=https://launch.example.com
# Coin-Seiten laufen unter <id>.<SITES_DOMAIN> (Wildcard-DNS und -Zertifikat nötig)
SITES_DOMAIN=coins.example.com
# Mindestens 32 Zeichen, zufällig: openssl rand -hex 32
SESSION_SECRET=
# Ohne Key gibt es keine Inhaltsprüfung, und dann wird nichts veröffentlicht
ANTHROPIC_API_KEY=
# Eigener RPC-Anbieter (z. B. Helius). Der öffentliche Endpunkt ist stark limitiert.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Zugang ---
# Plattform-Token: Wer ihn hält, darf sich anmelden. Mindestbestand:Launches pro 24 h, kommagetrennt.
GATE_MINT=
GATE_TIERS=100000:1,1000000:3,10000000:10
# Wallets, die ohne Token zugelassen sind (Bootstrap vor dem ersten Token)
ALLOWLIST=
ALLOWLIST_PER_DAY=3

# --- Optional ---
# Plattform-Gebühr pro Launch (Teil der signierten Transaktion), in Lamports: 50000000 = 0,05 SOL
FEE_WALLET=
FEE_LAMPORTS=0
PRIORITY_MICRO_LAMPORTS=50000
# Hinter einem Reverse-Proxy: X-Forwarded-For für die Client-IP nutzen
TRUST_PROXY=0
PORT=3000
DATA_DIR=./data

# --- Nur lokale Entwicklung (im Produktivbetrieb verboten, der Start bricht ab) ---
# GATE_OPEN=1            jede Wallet bekommt das Allowlist-Kontingent
# ALLOW_UNMODERATED=1    Inhaltsprüfung überspringen, wenn kein API-Key da ist
