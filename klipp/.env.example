# Kopiere diese Datei nach .env und trag deine Werte ein. .env wird nie committet.

# Claude für Titel, Zusammenfassung, Kapitel, „Frag das Video“, Anleitungen und Übersetzungen.
# Key unter https://console.anthropic.com → API Keys. Ohne Key läuft alles andere trotzdem.
ANTHROPIC_API_KEY=

# Wo die Aufnahmen liegen (Standard: ~/Klipp)
# KLIPP_LIBRARY=/Users/du/Klipp

# Transkript-Modell (lokal). base = schnell, small = genauer, large-v3-turbo = am besten, braucht mehr Zeit
# KLIPP_WHISPER_MODEL=onnx-community/whisper-small_timestamped

# Port und Erreichbarkeit. 0.0.0.0 = auch andere Geräte in deinem WLAN können Links öffnen.
# KLIPP_PORT=4747
# KLIPP_HOST=127.0.0.1

# Browser beim Start automatisch öffnen
KLIPP_OPEN=1
