{
  "functions": {
    "api/chat.js": { "maxDuration": 60 },
    "api/post.js": { "maxDuration": 120 },
    "api/admin.js": { "maxDuration": 300 },
    "api/mcp.js": { "maxDuration": 10 }
  },
  "crons": [
    { "path": "/api/post", "schedule": "7 15 * * *" }
  ],
  "headers": [
    { "source": "/admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "X-Frame-Options", "value": "DENY" }] }
  ]
}
