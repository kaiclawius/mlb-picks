# ChumGPT stream settings. This file lives at /etc/chumstream.env on the server.
# It holds your stream key: never paste it into a chat, a repo or a screenshot.

# From pump.fun: your coin page -> Start Livestream -> RTMP. Leave empty for a dry run (encodes, sends nothing).
RTMP_URL=
STREAM_KEY=

# ---- Phase 2: ChumGPT answers the chat and greets new minions ----
# The coin's address (mint). Without it the brain stays off and the stream runs the scripted show.
CA=

# Claude API key from console.anthropic.com -> API Keys. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# Which Claude model answers the chat. Default claude-opus-5-5 (best answers, about $0.02 each).
# claude-haiku-5-5 costs about 40x less and is plenty for one-liners.
# CHAT_MODEL=claude-opus-5-5

# At most one AI answer every N seconds, and at most N AI answers per day (cost brake).
# CHAT_INTERVAL_S=30
# CHAT_DAILY_LIMIT=1500

# Turn parts off without touching code (1 = on, 0 = off)
# CHAT_ENABLED=1
# TRADES_ENABLED=1

# New-minion alerts read buys from PumpPortal's data feed. If it asks for a key, put it here.
# PUMPPORTAL_API_KEY=

# Phone alerts (optional): install the ntfy app, subscribe to a long random topic name, put it here.
# ALERT_URL=https://ntfy.sh/chumgpt-change-this-to-something-long-and-random

# Dead man's switch (optional): a free check on healthchecks.io (period 1 min, grace 3 min).
# The server pings it every minute while it is really on air. If the pings stop, healthchecks.io alerts you,
# even when the whole server is gone.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# Picture and sound. Defaults suit a 2 to 4 core server.
# WIDTH=1280
# HEIGHT=720
# FPS=30
# VIDEO_BITRATE=2500k
# AUDIO_BITRATE=128k
# X264_PRESET=veryfast

# Fresh browser every N hours, hidden inside the "karen pulled the plug" gag.
# RECYCLE_HOURS=6
