# ChumGPT stream settings. This file lives at /etc/chumstream.env on the server.
# It holds your stream key: never paste it into a chat, a repo or a screenshot.

# From pump.fun: your coin page -> Start Livestream -> RTMP. Leave empty for a dry run (encodes, sends nothing).
RTMP_URL=
STREAM_KEY=

# Phone alerts (optional): install the ntfy app, subscribe to a long random topic name, put it here.
# ALERT_URL=https://ntfy.sh/chumgpt-change-this-to-something-long-and-random

# Dead man's switch (optional): a free check on healthchecks.io (period 1 min, grace 3 min).
# The server pings it every minute while it is really on air. If the pings stop, healthchecks.io alerts you,
# even when the whole server is gone.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# Picture and sound. Defaults suit a 2 to 4 core server.
# WIDTH=1280
# HEIGHT=720
# FPS=30
# VIDEO_BITRATE=2500k
# AUDIO_BITRATE=128k
# X264_PRESET=veryfast

# Fresh browser every N hours, hidden inside the "karen pulled the plug" gag.
# RECYCLE_HOURS=6
