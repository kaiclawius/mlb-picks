[Unit]
Description=ChumGPT 24/7 lab stream
After=network-online.target
Wants=network-online.target
# never stop trying to come back
StartLimitIntervalSec=0

[Service]
User=chum
Group=chum
WorkingDirectory=/opt/chumstream/stream
EnvironmentFile=/etc/chumstream.env
Environment=RUN_DIR=/run/chumstream CHROMIUM_PATH=/usr/bin/google-chrome
RuntimeDirectory=chumstream
ExecStart=/usr/bin/node /opt/chumstream/stream/supervisor.mjs
Restart=always
RestartSec=3
# stopping or restarting takes the whole process tree (browser, encoder, screen) with it
KillMode=control-group
TimeoutStopSec=15
OOMScoreAdjust=-500
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
