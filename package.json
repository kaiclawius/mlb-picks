{
  "name": "launchpad",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && tsx watch src/server.ts",
    "start": "npm run build && tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild client/app.ts --bundle --minify --format=iife --target=es2022 --outfile=public/app.js",
    "e2e": "npm run build && tsx test/e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.1.4",
    "@pump-fun/pump-sdk": "^4.0.0",
    "@solana/web3.js": "^1.99.0",
    "@wallet-standard/app": "^1.1.1",
    "bs58": "^6.0.0",
    "hono": "^4.13.13",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@wallet-standard/base": "^1.1.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
